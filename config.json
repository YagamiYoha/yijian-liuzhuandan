{
  "app": {
    "title": "一键流转单生成工具",
    "port": 8090,
    "width": 1180,
    "height": 820
  },
  "word": {
    "enabled": true,
    "template": "templates/外破危险源情况流转单（长10长逸）2026.08.12.docx",
    "output_prefix": "外破危险源情况流转单",
    "word_bindings": {
      "a.工程名称": { "key": "project_name", "mode": "same_line" },
      "建设单位": { "key": "owner", "mode": "same_line" },
      "施工单位": { "key": "builder", "mode": "same_line" },
      "b.负责人信息": { "key": "responsible_info", "mode": "same_line" },
      "4.施工地点": { "key": "address", "mode": "same_line" },
      "1.线路名称": { "key": "line_name", "mode": "same_line" },
      "5.危险点排摸": { "key": "danger_points", "mode": "same_line" },
      "设备主人名称": { "key": "equipment_owner", "mode": "replace_paragraph" },
      "date": { "key": "form_date", "mode": "date" },
      "c.工程动向": { "key": "engineering_trend", "mode": "next_paragraph" },
      "3.该工程施工变情况": { "key": "construction_change", "mode": "same_line" }
    }
  },
  "excel": {
    "enabled": true,
    "template": "templates/2026输电运检1班危险源统计表（更新至20260901）万羿辉.xlsx",
    "output_prefix": "危险源统计表",
    "sheet_name": "万羿辉",
    "total_sheet": "危险源统计表（总表）",
    "append_row": true,
    "column_map": {
      "等级": "risk_level",
      "施工类型": "construction_type",
      "电压等级（kV）": "voltage_level",
      "线路名称": "line_name",
      "杆号": "pole_no",
      "设备主人": "equipment_owner",
      "施工/责任单位": "builder",
      "建设（管理）单位": "owner",
      "施工单位": "builder",
      "施工单位联系人": "responsible_info",
      "项目名称": "project_name",
      "是否为大型市政工程": "large_municipal",
      "所属区": "district",
      "所属街道/镇": "town",
      "主要施工机械": "construction_machinery",
      "地址": "address",
      "危险源描述": "danger_points",
      "发现日期": "form_date",
      "探头个数": "probe_count",
      "探头位置\n（杆号）": "probe_position",
      "春节后复工日期（不施工填“不停工”）": "resume_date",
      "是否需要部室继续推进协调（是/否）": "need_coordination",
      "预计施工结束时间": "expected_end",
      "采取安全措施": "safety_measures"
    }
  },
  "fields": [
    { "key": "project_name", "label": "工程名称", "keywords": ["工程名称", "项目名称"], "group": "工程信息", "source": "ocr" },
    { "key": "address", "label": "建设地址", "keywords": ["建设地址", "工程地址", "地址"], "group": "工程信息", "source": "ocr" },
    { "key": "owner", "label": "建设单位", "keywords": ["建设单位", "业主单位"], "group": "工程信息", "source": "ocr" },
    { "key": "builder", "label": "施工单位", "keywords": ["施工单位", "总包单位", "承建单位"], "group": "工程信息", "source": "ocr" },
    { "key": "supervisor", "label": "监理单位", "keywords": ["监理单位"], "group": "工程信息", "source": "ocr" },
    { "key": "category", "label": "工程类别", "group": "工程信息", "source": "manual", "input_type": "select", "allow_custom": true, "options": ["工地", "空地", "堆场", "手动输入"] },
    { "key": "start_date", "label": "开工日期", "keywords": ["开工日期"], "group": "工程信息", "source": "ocr", "input_type": "date", "allow_text": true },
    { "key": "end_date", "label": "竣工日期", "keywords": ["竣工日期"], "group": "工程信息", "source": "ocr", "input_type": "date", "allow_text": true },
    { "key": "manager", "label": "项目经理", "keywords": ["项目经理", "项目负责人"], "group": "工程信息", "source": "ocr" },
    { "key": "manager_phone", "label": "项目经理联系方式", "keywords": ["项目经理联系方式", "项目经理手机", "项目经理电话", "手机"], "requires_digit": true, "group": "工程信息", "source": "ocr" },
    { "key": "manager2", "label": "项目经理2", "keywords": ["负责人", "现场负责人", "施工负责人"], "group": "工程信息", "source": "ocr" },
    { "key": "manager2_phone", "label": "联系方式", "keywords": ["负责人联系方式", "负责人手机", "负责人电话", "联系方式", "电话"], "requires_digit": true, "group": "工程信息", "source": "ocr" },
    { "key": "line_name", "label": "线路名称", "group": "蓝色选项", "input_type": "text" },
    { "key": "danger_points", "label": "危险点排摸", "group": "蓝色选项", "input_type": "textarea" },
    { "key": "equipment_owner", "label": "设备主人", "group": "蓝色选项", "input_type": "text", "default": "万羿辉" },
    { "key": "risk_level", "label": "危险源等级", "group": "蓝色选项", "input_type": "select", "options": ["一般", "重要"], "default": "重要" },
    { "key": "construction_type", "label": "施工类型", "group": "蓝色选项", "input_type": "select", "options": ["工地", "空地"], "default": "工地" },
    { "key": "voltage_level", "label": "电压等级", "group": "蓝色选项", "input_type": "select", "options": ["10kV", "35kV", "110kV"], "default": "10kV" },
    { "key": "pole_no", "label": "杆号", "group": "蓝色选项", "input_type": "text" },
    { "key": "engineering_trend", "label": "工程动向", "group": "工程动向", "input_type": "textarea" },
    { "key": "safety_notice", "label": "是否安全告知", "group": "工程动向", "input_type": "select", "options": ["是", "否", "留置送达"] },
    { "key": "site_plan_provided", "label": "施工方是否提供平面图", "group": "工程动向", "input_type": "select", "options": ["是", "否"] },
    { "key": "cooperation_level", "label": "预估施工方配合程度", "group": "工程动向", "input_type": "select", "options": ["积极", "一般", "消极"] },
    { "key": "construction_change", "label": "施工变情", "group": "工程动向", "input_type": "textarea" },
    { "key": "form_date", "label": "填报日期", "group": "蓝色选项", "input_type": "date", "allow_text": true, "default_today": true },
    { "key": "district", "label": "所属区", "group": "Excel补充", "input_type": "text", "default": "宝山区" },
    { "key": "town", "label": "所属街道/镇", "group": "Excel补充", "input_type": "text" },
    { "key": "construction_machinery", "label": "主要施工机械", "group": "Excel补充", "input_type": "text" },
    { "key": "large_municipal", "label": "大型市政工程", "group": "Excel补充", "input_type": "select", "options": ["是", "否"], "default": "否" },
    { "key": "probe_count", "label": "探头个数", "group": "Excel补充", "input_type": "text" },
    { "key": "probe_position", "label": "探头位置（杆号）", "group": "Excel补充", "input_type": "text" },
    { "key": "resume_date", "label": "复工日期", "group": "Excel补充", "input_type": "text" },
    { "key": "need_coordination", "label": "需要部门协调", "group": "Excel补充", "input_type": "select", "options": ["是", "否"], "default": "否" },
    { "key": "expected_end", "label": "预计结束时间", "group": "Excel补充", "input_type": "text" },
    { "key": "safety_measures", "label": "采取安全措施", "group": "Excel补充", "input_type": "textarea" }
  ],
  "images": [
    { "key": "nameplate", "label": "铭牌图片", "placeholder": "{{铭牌图片}}", "width_cm": 16.0 }
  ],
  "attachments": [
    { "placeholder": "{{附件}}" }
  ]
}
